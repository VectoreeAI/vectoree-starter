# 由 CI 在第一次部署时复制成 /opt/vectoree-starter/.env。
# 每次部署 CI 都会覆盖这些值：
#   STARTER_*_IMAGE
#   VECTOREE_API_URL：dev -> https://vectoree.net，main -> https://vectoree.ai
#   DEPLOY_MODE=cloud
STARTER_SERVER_IMAGE=
STARTER_WEB_IMAGE=
VECTOREE_API_URL=https://vectoree.ai
STARTER_WEB_PORT=5173
DEPLOY_MODE=cloud
